{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZooChattr",
  "version": "../package.json",
  "identifier": "com.geckoofshadow.zoochattr",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:17420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZooChattr",
        "width": 1180,
        "height": 760,
        "minWidth": 360,
        "minHeight": 420,
        "backgroundColor": "#090d0a",
        "create": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: https://static-cdn.jtvnw.net https://cdn.7tv.app https://cdn.betterttv.net https://cdn.frankerfacez.com",
        "connect-src": "ipc: http://ipc.localhost 'self' wss://irc-ws.chat.twitch.tv https://id.twitch.tv https://api.twitch.tv https://7tv.io https://api.betterttv.net https://api.frankerfacez.com https://zoochattr-logger.gecko-apps.workers.dev"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
