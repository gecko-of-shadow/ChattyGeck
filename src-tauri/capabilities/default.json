{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main ZooChattr window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-request-user-attention",
    "opener:default",
    "allow-app-info",
    "allow-settings-load",
    "allow-settings-save",
    "allow-chat-history-load",
    "allow-chat-history-save",
    "allow-chat-history-append",
    "allow-chat-history-clear",
    "allow-session-load",
    "allow-session-save",
    "allow-session-clear",
    "allow-history-token-load",
    "allow-auth-display",
    "allow-set-close-to-tray",
    "allow-set-tray-status",
    "allow-quit-app",
    "allow-finish-exit",
    "allow-get-launch-at-login",
    "allow-set-launch-at-login",
    "allow-check-for-update",
    "allow-apply-update",
    "allow-open-settings-window-cmd"
  ]
}
