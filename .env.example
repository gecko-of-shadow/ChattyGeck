# Twitch application Client ID (public, not a secret).
# Create one at https://dev.twitch.tv/console/apps/create
#   Client Type: Public
#   OAuth Redirect URLs: http://localhost   (required by the form; ChatDeck uses device login and never redirects)
# Leave empty to run in read-only mode; login can also be configured later in Settings.
TWITCH_CLIENT_ID=

# Optional endpoint overrides, used for the offline mock server (npm run mock:twitch).
# VITE_TWITCH_IRC_URL=ws://127.0.0.1:17422
# VITE_TWITCH_AUTH_BASE=http://127.0.0.1:17423
# VITE_TWITCH_HELIX_BASE=http://127.0.0.1:17423/helix
