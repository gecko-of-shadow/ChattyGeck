{
  "name": "zoochattr",
  "private": true,
  "version": "0.4.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "soak": "node scripts/soak.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mock:twitch": "node scripts/mock-twitch.mjs",
    "dev:mock": "vite --mode mock --port 17440",
    "e2e:mock": "node scripts/e2e-mock.mjs",
    "build:portable": "tauri build --no-bundle && node scripts/package-portable.mjs",
    "build:windows-cross": "tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --no-bundle && node scripts/package-portable.mjs",
    "tauri:mock": "tauri dev --config src-tauri/tauri.mock.conf.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.55.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "playwright-core": "^1.64.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  }
}
