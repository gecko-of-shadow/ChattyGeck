# Points ZooChattr at the offline mock Twitch (npm run mock:twitch). Used by `vite --mode mock`.
TWITCH_CLIENT_ID=mock-client-id
VITE_TWITCH_IRC_URL=ws://127.0.0.1:17422
VITE_TWITCH_AUTH_BASE=http://127.0.0.1:17423
VITE_TWITCH_HELIX_BASE=http://127.0.0.1:17423/helix
VITE_7TV_API=http://127.0.0.1:17423/7tv
VITE_BTTV_API=http://127.0.0.1:17423/bttv
VITE_FFZ_API=http://127.0.0.1:17423/ffz
